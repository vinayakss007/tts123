{
  "annotations": { "list": [] },
  "editable": true,
  "title": "DAaaS Platform Overview",
  "uid": "daaas-overview",
  "panels": [
    {
      "title": "API Request Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(django_http_requests_total[5m])", "legendFormat": "{{method}} {{status}}" }
      ]
    },
    {
      "title": "Response Time (p95)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, rate(django_http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95" }
      ]
    },
    {
      "title": "Celery Task Queue",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "celery_tasks_total", "legendFormat": "{{state}}" }
      ]
    },
    {
      "title": "AI Token Usage",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(ai_tokens_used_total)", "legendFormat": "Total Tokens" }
      ]
    }
  ],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s"
}
